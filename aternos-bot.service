[Unit]
Description=Aternos Discord Bot Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Aternos-Discord-Bot
EnvironmentFile=/root/Aternos-Discord-Bot/.env
ExecStart=/usr/bin/python3 /root/Aternos-Discord-Bot/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
