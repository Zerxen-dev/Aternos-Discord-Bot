# ─────────────────────────────────────────────────────────────
#  Aternos Discord Bot — Environment Variables
#
#  Pterodactyl Panel:  Add these in the "Variables" tab of
#                      your server, then restart the server.
#
#  Local / other host: Copy this file to ".env" and fill in
#                      your values.
# ─────────────────────────────────────────────────────────────

# Your Discord bot token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Your Aternos account username
ATERNOS_USER=your_aternos_username

# Your Aternos account password
ATERNOS_PASS=your_aternos_password

# ── Optional settings ───────────────────────────────────────────

# Restrict /start, /stop, /restart, /autostart and /autostop to specific
# Discord role IDs and/or user IDs (comma-separated). Leave both empty/unset
# to leave every command open to everyone (the default).
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=

# How often (in seconds) the autostart/autostop background monitor checks
# the server. Default: 60
AUTOSTART_POLL_SECONDS=60

# Default number of empty minutes before /autostop shuts the server down,
# used when /autostop is enabled without an explicit `minutes:` value.
AUTOSTOP_DEFAULT_MINUTES=20

# Where to persist autostart/autostop settings between restarts.
# Default: autostart_state.json next to the bot's source files.
STATE_FILE=
