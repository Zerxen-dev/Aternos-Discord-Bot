# ─────────────────────────────────────────────────────────────
#  Aternos Discord Bot v2.0 — Environment Variables Configuration
# ─────────────────────────────────────────────────────────────

# [REQUIRED] Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# [REQUIRED] Aternos Account Credentials
ATERNOS_USER=your_aternos_username
ATERNOS_PASS=your_aternos_password

# ── Permissions & Access Control ──────────────────────────────
# Comma-separated Discord Role IDs or User IDs authorized for admin commands
# (e.g. /start, /stop, /restart, /console, /backup, /setproperty, /schedule)
# Leave blank to allow all members to execute commands.
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=

# ── Automation & State ────────────────────────────────────────
# Background polling interval in seconds (default: 60)
AUTOSTART_POLL_SECONDS=60

# Default idle minutes with 0 players before auto-stop initiates (default: 20)
AUTOSTOP_DEFAULT_MINUTES=20

# Persistent JSON state file path
STATE_FILE=autostart_state.json

# ── Web Management Dashboard & REST API ───────────────────────
# Enable the integrated FastAPI management dashboard
WEB_DASHBOARD_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Secret API key protecting web dashboard operations and REST endpoints
# If unset, web dashboard is open without authentication
WEB_API_KEY=change_this_to_a_secure_token

# ── AI Natural Language Assistant (/ask) ──────────────────────
# Provider: 'gemini' or 'openai' (leave blank for local heuristic NLP)
AI_PROVIDER=gemini

# API key for the chosen AI provider
AI_API_KEY=

# ── Observability & Monitoring ────────────────────────────────
# Optional Sentry DSN for crash tracking and performance tracing
SENTRY_DSN=

# Log format: 'text' or 'json' (structured for datadog/grafana)
LOG_FORMAT=text
